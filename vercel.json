{
  "name": "financial-data-extraction-monorepo",
  "version": 2,
  "workspaces": [
    "Frontend",
    "Backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd Frontend && npm start",
    "dev:backend": "cd Backend && npm run start"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
